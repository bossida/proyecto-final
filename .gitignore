# ----------------------------------------------------------------------
# 1. GENERATED & COMPILED FILES
# Files that can be easily recreated or are the output of a build process.
# ----------------------------------------------------------------------

# Compiled source files (e.g., C/C++, Java)
*.o
*.obj
*.exe
*.dll
*.class
*.so
*.dylib

# Compiled Python files
*.pyc
__pycache__/

# Build/Distribution directories
dist/
build/
target/
temp/
out/

# ----------------------------------------------------------------------
# 2. DEPENDENCIES & PACKAGE MANAGEMENT
# Directories that contain project dependencies managed by tools.
# ----------------------------------------------------------------------

# Node.js dependencies
node_modules/

# Python virtual environments
venv/
.venv/
env/
.env/

# PHP Composer dependencies
vendor/

# ----------------------------------------------------------------------
# 3. EDITOR / IDE FILES
# Personal settings and temporary files generated by your development environment.
# ----------------------------------------------------------------------

# VS Code
.vscode/

# JetBrains IDEs (IntelliJ, PyCharm, WebStorm, etc.)
.idea/

# Vim/Nano swap files
*~
*.swp

# ----------------------------------------------------------------------
# 4. OPERATING SYSTEM & LOGS
# Files generated by the OS or application logs.
# ----------------------------------------------------------------------

# macOS system files
.DS_Store

# Windows system files
Thumbs.db

# Log files
*.log

# ----------------------------------------------------------------------
# 5. SENSITIVE / ENVIRONMENT FILES
# Files containing credentials, secrets, or local configuration.
# NEVER commit these to a repository.
# ----------------------------------------------------------------------
.env
.env.local
.DS_STORE

# For Linux/Unix users, files ending with a tilde (~) are temporary backup files
*~


# ----------------------------------------------------------------------
# TERRAFORM IGNORE LIST
# Files/directories that are generated, hold state, or contain secrets.
# ----------------------------------------------------------------------

# 1. Local .terraform directories (Downloaded Providers/Modules)
# This directory is large and is regenerated every time 'terraform init' is run.
**/.terraform/

# 2. Terraform State Files
# The state file contains the actual resource attributes, including secrets.
# NEVER commit this unless you are managing state locally, which is generally
# discouraged for team environments.
*.tfstate
*.tfstate.*

# 3. Variable Files with Secrets
# Files that often contain sensitive data like passwords, keys, or endpoints.
# If you use a special file for secrets (e.g., prod.tfvars), you should ignore it.
*.tfvars
*.tfvars.json
*.pem

# 4. Terraform Plan Files
# These are output files from 'terraform plan -out=...'
*.tfplan

# 5. Crash Log Files
crash.log
crash.*.log

# 6. CLI Configuration Files
.terraformrc
terraform.rc

# 7. Lock Files (Optional, but often ignored for simplicity)
# Note: The .terraform.lock.hcl is generally RECOMMENDED to be committed
# to lock provider versions. Only ignore if you have a specific workflow reason.
# **/.terraform.lock.hcl


# NODE.JS DEPENDENCIES & ARTIFACTS
# Ignore the node_modules folder at the project root
/node_modules
# Ignore common log files
npm-debug.log*
yarn-error.log*
*.log
# Ignore build outputs (if generated at the root)
/dist
/build

# IDE AND OS FILES
# General IDE/OS files
/temp